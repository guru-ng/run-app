---
import App from "@/components/App.tsx";

const title = "run";
const description =
	"A quiet running community. Log your runs, match distances, run together — for health and mindfulness, not competition.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<div class="mark">
				<span class="dot"></span>
				<span class="wordmark">run</span>
			</div>
			<App client:only="react" />
			<footer>
				<span>An experiment by <a href="https://snjv.club">Sanjeev Gurung</a></span>
			</footer>
		</main>

		<style is:global>
			:root {
				--bg: #0e1512;
				--bg-glow: #16211c;
				--fg: #e8efe9;
				--muted: #8fa89b;
				--accent: #57b894;
				--accent-soft: rgba(87, 184, 148, 0.15);
				--panel: rgba(255, 255, 255, 0.03);
				--border: rgba(255, 255, 255, 0.08);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html,
			body {
				height: 100%;
			}

			body {
				font-family:
					ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
					Helvetica, Arial, sans-serif;
				color: var(--fg);
				background:
					radial-gradient(
						1200px 800px at 50% -10%,
						var(--bg-glow),
						transparent 60%
					),
					var(--bg);
				-webkit-font-smoothing: antialiased;
			}

			main {
				min-height: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 2rem;
				text-align: center;
				gap: 1.5rem;
			}

			.mark {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
			}

			.dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
				background: var(--accent);
				animation: breathe 4s ease-in-out infinite;
			}

			.wordmark {
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: 0.02em;
				color: var(--accent);
			}

			/* Auth / app panels (rendered by React) */
			.panel {
				width: 100%;
				max-width: 26rem;
				display: flex;
				flex-direction: column;
				gap: 1.1rem;
				padding: 2rem;
				background: var(--panel);
				border: 1px solid var(--border);
				border-radius: 16px;
				animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
			}

			.brand-title {
				font-size: clamp(1.6rem, 5vw, 2.1rem);
				font-weight: 650;
				line-height: 1.1;
				letter-spacing: -0.02em;
			}

			.muted {
				color: var(--muted);
				line-height: 1.6;
				font-size: 0.98rem;
			}

			.form {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.input {
				width: 100%;
				padding: 0.75rem 0.9rem;
				border-radius: 10px;
				border: 1px solid var(--border);
				background: rgba(0, 0, 0, 0.25);
				color: var(--fg);
				font-size: 1rem;
			}

			.input:focus {
				outline: none;
				border-color: var(--accent);
			}

			.btn {
				width: 100%;
				padding: 0.8rem 1rem;
				border-radius: 10px;
				border: none;
				background: var(--accent);
				color: #05110c;
				font-size: 1rem;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 150ms ease;
			}

			.btn:hover {
				opacity: 0.9;
			}

			.btn:disabled {
				opacity: 0.6;
				cursor: default;
			}

			.link {
				background: none;
				border: none;
				color: var(--muted);
				font-size: 0.9rem;
				cursor: pointer;
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.link:hover {
				color: var(--accent);
			}

			.error {
				color: #ff8080;
				font-size: 0.9rem;
			}

			footer {
				font-size: 0.85rem;
				color: var(--muted);
			}

			footer a {
				color: var(--muted);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			footer a:hover {
				color: var(--accent);
			}

			@keyframes breathe {
				0%,
				100% {
					transform: scale(0.9);
				}
				50% {
					transform: scale(1.1);
				}
			}

			@keyframes rise {
				from {
					opacity: 0;
					transform: translateY(10px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.dot,
				.panel {
					animation: none;
				}
			}
		</style>
	</body>
</html>
