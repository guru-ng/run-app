---
import App from "@/components/auth/App.tsx";
import BaseLayout from "@/layouts/BaseLayout.astro";

const description =
	"A quiet running community. Log your runs, match distances, run together — for health and mindfulness, not competition.";
---

<BaseLayout title="run" description={description}>
	<App client:only="react" tab="dashboard" transition:persist="app" />
	<footer>
		<span>An experiment by <a href="https://snjv.club">Sanjeev Gurung</a></span>
	</footer>
</BaseLayout>
